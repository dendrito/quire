{
  "name": "quire-pdf-studio",
  "productName": "Quire PDF Studio",
  "version": "1.2.0",
  "description": "Personal PDF viewer and editor for macOS that runs entirely offline",
  "main": "main.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/build-scanner.js && node scripts/vendor.js",
    "vendor": "node scripts/vendor.js",
    "start": "node scripts/build-scanner.js && node scripts/vendor.js && electron .",
    "dist": "node scripts/build-scanner.js && node scripts/vendor.js && electron-builder --mac",
    "scanner": "node scripts/build-scanner.js"
  },
  "devDependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/tinos": "0.4.2",
    "onnxruntime-web": "1.20.1",
    "@fontsource/caveat": "5.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/cat": "1.0.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_sim_vert": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/chi_tra_vert": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fas": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/heb": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/jpn_vert": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tesseract.js-data/kor_vert": "1.0.0",
    "@tesseract.js-data/nld": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/syr": "1.0.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "jsqr": "1.4.0",
    "jszip": "3.10.1",
    "node-forge": "1.4.0",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "1.4.4",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "build": {
    "appId": "local.quire.pdfstudio",
    "productName": "Quire PDF Studio",
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Quire uses the camera to scan paper pages into PDFs. Photos stay on this Mac."
      }
    },
    "dmg": {
      "title": "Quire PDF Studio"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "quire-scan"
        ]
      }
    ]
  }
}
